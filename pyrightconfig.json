{
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "."
  ],
  "extraPaths": [
    "."
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".venv"
  ],
  "reportMissingImports": true,
  "typeCheckingMode": "basic",
  "executionEnvironments": [
    {
      "root": "."
    }
  ]
}
